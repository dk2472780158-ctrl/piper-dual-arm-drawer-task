#!/usr/bin/env bash
# 机器相关路径备忘 / 换机器对照表。
#
# ⚠ 这份**不被任何脚本 source**。三段启动器各自在文件顶部把这些值写死了
#   （第 40~65 行那一块），所以照抄这份文件到 config/env.local.sh 不会改任何
#   行为 —— 它只是把"要改哪些行"列清楚。真要换机器，改启动器里对应的那一行。
#
# 唯一一个真能从环境变量改的是 PI0_PY（其余都是硬赋值）：
#     PI0_PY=/别的/python bash full/run_full.sh check

# ---- 推理根：verified_hardware.py 与 reports/ 都在它下面 --------------------
LROOT=/home/databall/pi0_drawer_mixed_74_v1

# ---- 两个解释器（不是同一个环境，别混） -------------------------------------
# 客户端 / 相机闸门 / 姿态闸门 / 链路自检用。实测这个 .venv 里有：
#   requests 2.34.2 / numpy 2.2.6 / websockets 17.2 / pyrealsense2 2.59.1 / piper_sdk
# （没有 openpi_client —— 回放客户端走 HTTP，不需要它。）
# 注意本包不带 .venv：推理根下那个 .venv 是指向旧目录里那套的软链，属机器配置。
#   能覆盖：PI0_PY=...
PY=${PI0_PY:-/home/databall/pi0_infer_3090/.venv/bin/python}

# 回放服务端 + 轨迹构建用：要有 numpy、pyarrow。跟上面那个不是一套。
SPY=/home/databall/miniconda3/envs/lerobot_v30/bin/python

# ---- 硬件互斥锁（teleop / 录制 / 别的 rollout 也会抢它） --------------------
LOCK=/home/databall/pico_piper_teleop/runtime/hardware.lock

# ---- 只在 full/run_full.sh 用到 --------------------------------------------
# 真机模式开跑前那一步"官方归位"。
RESETSH=/home/databall/reset_piper.sh
# 姿态闸门（pose 模式）只读跑官方的 reset_piper_pose.py，用它自己那套解释器环境。
RESETDIR=/home/databall/VLA/lerobot_piper

# ---- 只在 PI0_REBUILD=1 重建轨迹时用到 -------------------------------------
# 演示语料根（本仓不含）。默认值：
#   PI0_DATA=${PI0_DATA:-/home/databall/drawer_today99_v1/dataset_train}
